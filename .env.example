# Copy this file to `.env` and fill in the values.

# --- Database (Neon Postgres + PostGIS) ---
# Neon serverless connection string. Used by Drizzle (runtime) and drizzle-kit
# (migrations). Include `?sslmode=require`.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Maps / geocoding (free, no keys) ---
# Maps: MapLibre GL JS + OpenFreeMap tiles (no API key).
# Geocoding: Nominatim / OpenStreetMap via `/api/geocode` and `pnpm db:seed`
# (polite User-Agent, ~1 req/s). No Mapbox or other paid map keys required.

# --- Neon Auth (Managed Better Auth via @neondatabase/auth) ---
# From Neon Console: Project → Branch → Auth → Configuration.
# Copy the Auth URL exactly. Generate the cookie secret with:
#   openssl rand -base64 32
# Without these, /auth/sign-in shows setup instructions and protected routes
# redirect there (no fake demo session).
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="your-secret-at-least-32-characters-long"
